import { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Button } from "@/components/ui/button";

const dictionary = {
  "i": "arai",
  "me": "arai",
  "you": "tiran",
  "he": "ulkan",
  "she": "ulkan",
  "it": "ulkan",
  "we": "valar",
  "us": "valar",
  "they": "thurin",
  "them": "thurin",
  "is": "serak",
  "are": "serak",
  "am": "serak",
  "have": "moren",
  "has": "moren",
  "go": "zulen",
  "come": "norak",
  "see": "vilar",
  "say": "rakor",
  "know": "silven",
  "think": "yural",
  "want": "trelgar",
  "can": "elmak",
  "like": "varen",
  "love": "aeril",
  "hate": "kragul",
  "make": "durok",
  "build": "durok",
  "break": "fragul",
  "destroy": "fragul",
  "run": "skaleth",
  "walk": "meldor",
  "sleep": "dormek",
  "wake": "narok",
  "day": "soel",
  "morning": "finuar",
  "evening": "lomur",
  "yes": "thor",
  "no": "nahr",
  "please": "vinal",
  "thank": "merath",
  "hello": "shalen",
  "goodbye": "thirak",
  "help": "askor",
  "danger": "grelak",
  "safe": "kareth",
  "now": "ilun",
