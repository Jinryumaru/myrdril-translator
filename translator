  "behind": "dorath",
  "for": "venath",
  "of": "selar",
  "from": "kelar",
  "to": "ralen"
};

function translateToMyrdril(text) {
  return text
    .toLowerCase()
    .split(/\s+/)
    .map(word => dictionary[word] || `[${word}]`)
    .join(" ");
}

export default function MyrdrilTranslator() {
  const [input, setInput] = useState("");
  const [output, setOutput] = useState("");

  const handleTranslate = () => {
    const translation = translateToMyrdril(input);
    setOutput(translation);
  };

  return (
    <div className="max-w-xl mx-auto p-4">
      <h1 className="text-2xl font-bold mb-4">Myrdril Translator</h1>
      <Card className="mb-4">
        <CardContent className="space-y-4 pt-4">
          <Textarea
            placeholder="Enter English text..."
            value={input}
            onChange={(e) => setInput(e.target.value)}
          />
          <Button onClick={handleTranslate}>Translate</Button>
          <Textarea
            placeholder="Myrdril translation..."
            value={output}
            readOnly
          />
        </CardContent>
      </Card>
    </div>
  );
}
